<?xml version="1.0" encoding="UTF-8"?>
<!--
    Database integration suite: real WordPress, real MySQL, real dbDelta. Opt-in, run by
    ./scripts/schema-tests.sh from inside the `wordpress` dev container.

    Separate from phpunit.xml.dist on purpose — that one scans ./tests/phpunit only, needs no
    WordPress and finishes in seconds, and it must stay that way.
-->
<phpunit bootstrap="tests/integration/bootstrap.php" colors="true">
    <testsuites>
        <testsuite name="Database Integration Suite">
            <directory>./tests/integration</directory>
        </testsuite>
    </testsuites>
</phpunit>
