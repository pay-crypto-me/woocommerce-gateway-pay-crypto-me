{
    "name": "paycrypto-me/paycrypto-me-for-woocommerce",
    "description": "PayCrypto.Me for WooCommerce offers a complete solution that allows your customers to pay using many cryptocurrencies in your store.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "autoload": {
        "classmap": [
            "includes/",
            "exceptions/"
        ]
    },
    "authors": [
        {
            "name": "PayCrypto.Me",
            "email": "contact@paycrypto.me"
        }
    ],
    "version": "0.1.1",
    "config": {
        "platform": {
            "php": "7.4"
        }
    },
    "require": {
        "ext-gmp": "*",
        "ext-gd": "*",
        "endroid/qr-code": "^4.6",
        "bitwasp/bitcoin": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    }
}
