msgstr "%1$s doit avoir au moins %2$d caractères."

#: includes/validators/class-lightning-config-validator.php:93
msgid "BTCPay webhook secret is shorter than the recommended 16 characters."
msgstr ""
"Le secret du webhook BTCPay est plus court que les 16 caractères recommandés."

#: includes/validators/class-lightning-config-validator.php:129
msgid "lnd Macaroon must be a valid hexadecimal string."
msgstr "Le Macaroon de lnd doit être une chaîne hexadécimale valide."

#: includes/validators/class-lightning-config-validator.php:143
msgid ""
"Invalid certificate format. Must be valid PEM format starting with -----"
"BEGIN CERTIFICATE-----."
msgstr ""
"Format de certificat non valide. Doit être un format PEM valide commençant "
"par -----BEGIN CERTIFICATE-----."

#: includes/validators/class-lightning-config-validator.php:153
msgid "Invoice Expiry must be at least 300 seconds (5 minutes)."
msgstr ""
"L'expiration de la facture doit être d'au moins 300 secondes (5 minutes)."

#: includes/validators/class-lightning-config-validator.php:157
msgid "Invoice Expiry cannot exceed 86400 seconds (24 hours)."
msgstr ""
"L'expiration de la facture ne peut pas dépasser 86400 secondes (24 heures)."

#: paycrypto-me-for-woocommerce.php:35
