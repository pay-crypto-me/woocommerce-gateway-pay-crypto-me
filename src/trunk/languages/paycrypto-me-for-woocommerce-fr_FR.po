msgstr "Réseau Lightning"

#: includes/class-wc-gateway-paycrypto-me-lightning.php:29
msgid "Accept Bitcoin payments self-hosted via Lightning Network"
msgstr "Acceptez les paiements Bitcoin auto-hébergés via le réseau Lightning"

#: includes/class-wc-gateway-paycrypto-me-lightning.php:29
#: includes/class-wc-gateway-paycrypto-me.php:36
msgid "Provided by PayCrypto.Me"
msgstr "Fourni par PayCrypto.Me"

#: includes/class-wc-gateway-paycrypto-me-lightning.php:106
msgid "Proxy Settings"
msgstr "Paramètres du Proxy"

#: includes/class-wc-gateway-paycrypto-me-lightning.php:108
msgid "Configure proxy settings for connecting to your Lightning node."
msgstr ""
"Configurez les paramètres du proxy pour vous connecter à votre nœud "
"Lightning."

#: includes/class-wc-gateway-paycrypto-me-lightning.php:111
msgid "Lightning Node Type"
msgstr "Type de Nœud Lightning"

#: includes/class-wc-gateway-paycrypto-me-lightning.php:116
msgid "Invoice Expiry"
msgstr "Expiration de la Facture"

#: includes/class-wc-gateway-paycrypto-me-lightning.php:118
msgid ""
"Time before invoice expires. Min: 300 (5 min), Max: 86400 (24h). Default: "
"3600 (1 hour)"
msgstr ""
"Temps avant l'expiration de la facture. Min: 300 (5 min), Max: 86400 (24 h). "
"Par défaut: 3600 (1 heure)"

#. translators: %s: field label, e.g. "BTCPay Server URL".
#: includes/class-wc-gateway-paycrypto-me-lightning.php:129
