#. Plugin Name of the plugin
#: paycrypto-me-for-woocommerce.php
msgid "PayCrypto.Me for WooCommerce"
msgstr "PayCrypto.Me pour WooCommerce"

#. Plugin URI of the plugin
#: paycrypto-me-for-woocommerce.php
msgid "https://paycrypto.me/woocommerce/"
msgstr "https://paycrypto.me/woocommerce/"

#. Description of the plugin
#: paycrypto-me-for-woocommerce.php
msgid ""
"PayCrypto.Me for WooCommerce lets your store accept Bitcoin payments — On-"
"Chain and Lightning Network — directly into wallets and nodes you control."
msgstr ""
"PayCrypto.Me pour WooCommerce permet à votre boutique d'accepter les "
"paiements en Bitcoin — On-Chain et Lightning Network — directement dans les "
"portefeuilles et nœuds que vous contrôlez."

#. Author of the plugin
#: paycrypto-me-for-woocommerce.php
msgid "PayCrypto.Me"
msgstr "PayCrypto.Me"

