msgstr "Knoten: %s"

#. translators: %d: HTTP status code
#: includes/services/class-lightning-connection-tester.php:132
#, php-format
msgid "Connection OK (HTTP %d)."
msgstr "Verbindung OK (HTTP %d)."

#. translators: %d: HTTP status code
#: includes/services/class-lightning-connection-tester.php:146
#, php-format
msgid "Request failed (HTTP %d)."
msgstr "Anfrage fehlgeschlagen (HTTP %d)."

#: includes/services/class-lnd-rest-invoice-service.php:114
msgid "Payment via Lightning node failed. Please try again."
