msgstr "Секрет Webhook BTCPay"

#. translators: %s: short add-on name (not translated, product name), e.g. "Pro".
#: includes/class-wc-gateway-paycrypto-me-lightning.php:187
#, php-format
msgid "Reserved for the %s add-on. Not used by the free version."
msgstr ""
"Зарезервировано для дополнения %s. В бесплатной версии не используется."

#. translators: %s: short add-on name (not translated, product name), e.g. "Pro".
#: includes/class-wc-gateway-paycrypto-me-lightning.php:192
#, php-format
