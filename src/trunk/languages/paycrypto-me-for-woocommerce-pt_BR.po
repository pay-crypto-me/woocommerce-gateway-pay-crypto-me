#. Plugin Name of the plugin
#: paycrypto-me-for-woocommerce.php
msgid "PayCrypto.Me for WooCommerce"
msgstr "PayCrypto.Me para WooCommerce"

#. Plugin URI of the plugin
#: paycrypto-me-for-woocommerce.php
msgid "https://github.com/paycrypto-me/paycrypto-me-for-woocommerce"
msgstr "https://github.com/paycrypto-me/paycrypto-me-for-woocommerce"

#. Description of the plugin
#: paycrypto-me-for-woocommerce.php
msgid ""
"PayCrypto.Me for WooCommerce lets your store accept Bitcoin payments — On-"
"Chain and Lightning Network — directly into wallets and nodes you control."
msgstr ""
"PayCrypto.Me para WooCommerce permite que sua loja aceite pagamentos em "
"Bitcoin — Rede Blockchain e Lightning Network — diretamente em carteiras e "
"nós que você controla."

#. Author of the plugin
#: paycrypto-me-for-woocommerce.php
msgid "PayCrypto.Me"
msgstr "PayCrypto.Me"

#. Author URI of the plugin
#: paycrypto-me-for-woocommerce.php
msgid "https://paycrypto.me/"
msgstr "https://paycrypto.me/"

#: exceptions/PayCryptoMePaymentException.php:19
msgid ""
"We couldn't complete your payment. Please try again or contact support if "
"the problem persists."
msgstr ""
"Não conseguimos concluir seu pagamento. Tente novamente ou entre em contato "
"com o suporte se o problema persistir."

#: includes/abstract-class-wc-gateway-paycrypto-me.php:140
msgid ""
"We could not display the payment details for this order. Please contact the "
"store."
msgstr ""
"Não foi possível exibir os dados de pagamento deste pedido. Entre em contato "
"com a loja."

#: includes/abstract-class-wc-gateway-paycrypto-me.php:236
msgid "Network"
msgstr "Rede"

#: includes/abstract-class-wc-gateway-paycrypto-me.php:239
msgid "Select the network for payments."
msgstr "Selecione a rede para pagamentos."

#: includes/abstract-class-wc-gateway-paycrypto-me.php:248
